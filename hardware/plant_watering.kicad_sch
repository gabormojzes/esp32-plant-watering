	(text "To DFRobot SEN0308 sensor\n1  yellow  AOUT (0-2.9 V)\n2  unused\n3  red     VCC  (3.3-5.5 V)\n4  black   GND (both)"
		(exclude_from_sim no)
		(at 68.58 134.62 0)
