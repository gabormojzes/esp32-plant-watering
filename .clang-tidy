---
# Off, each for what it flags in this code:
#   easily-swappable-parameters   adjacent same-type parameters, such as (uri, media_type)
#   include-cleaner               ESP-IDF names that arrive through umbrella headers, and the
#                                 host-test stubs that stand in for them
#   non-private-member-variables  plain value types such as Color
#   use-anonymous-namespace       the static functions doctest's TEST_CASE expands to
#   avoid-c-arrays                TAG[] and the other string constants
#   use-trailing-return-type      every function; the code uses leading return types
#   use-nodiscard                 every getter
#   identifier-length             conventional short names such as c and ns
#   magic-numbers                 literals that name themselves, such as 100 for a percent
#   uppercase-literal-suffix      the lowercase 0.0f spelling used throughout
Checks: >
  bugprone-*,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -modernize-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix
HeaderFilterRegex: '.*/(main|test/host)/.*'
# stubs/ copies ESP-IDF's names and macros as ESP-IDF spells them, and third_party/ is vendored
ExcludeHeaderFilterRegex: '.*/test/host/(stubs|third_party)/.*'
FormatStyle: file
CheckOptions:
  # ESP_LOGx expands to nested conditionals; count only the code we write
  readability-function-cognitive-complexity.IgnoreMacros: 'true'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ClassConstantCase: UPPER_CASE
  readability-identifier-naming.GlobalConstantCase: UPPER_CASE
